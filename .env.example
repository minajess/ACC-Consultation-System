# Copy this file to ".env" and change the values before running the application.
# Never commit the real ".env" file to version control.

# A long, random, secret string used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# SQLite database file location (relative to the project root).
DATABASE_URL=sqlite:///instance/abuyog_consultation.db

# Flask environment: "development" or "production"
FLASK_ENV=development

# Set to "1" to enable Flask debug mode (development only - never in production)
FLASK_DEBUG=1
